# Postgres. Supabase au départ, mais rien n'y est spécifique : n'importe quel
# Postgres fait l'affaire (Neon, Railway, auto-hébergé). C'est la seule ligne à
# changer pour déménager.
#
# Supabase : utiliser la connexion **directe** (port 5432) pour les migrations,
# et le pooler (port 6543) pour l'exécution.
DATABASE_URL="postgresql://postgres:password@localhost:5432/undercover"
